; Sound Clash Brawl — Godot project.
; Engine version pin: [TODO] record the exact Godot 4.x release the first time the
; project is opened, then add the matching config/features line here.
config_version=5

[application]

config/name="Sound Clash Brawl"
config/description="Sound Clash Brawl — arcade title screen plus the Feedback/Lickshot/Young Selecta roster."
run/main_scene="res://scenes/TitleScreen.tscn"

[autoload]

; Procedural arcade SFX (AGENTS.md §9 backlog item B8): every cue is synthesised with
; AudioStreamGenerator, so the build ships no audio files.
Sfx="*res://scripts/audio/SfxPlayer.gd"
; Event-driven Sound Clash audio engine (AGENTS.md §9 item 46): DJ tags through the native
; tape-delay AudioBusLayout, priorities/cooldowns, layered crowd and the 6 s round sting.
SoundClash="*res://scripts/audio/SoundClashAudio.gd"
; P1 / P2 / AI style / subtitle choices carried from TitleScreen.tscn into TestArena.tscn
; (AGENTS.md §9 backlog item B1).
MatchSetup="*res://scripts/MatchSetup.gd"
; Menu / victory beat bed (AGENTS.md §9 item 48). Silent during active rounds by design.
MusicBed="*res://scripts/audio/MusicBed.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
; PART B commit 5: the 1280×720 canvas is stretched with `canvas_items`/`keep`, so the HUD and the
; 2D layers stay sharp at any window size, and HiDPI is allowed so a retina phone renders at its
; own pixel density instead of a 1× blur. The 3D buffer is independently capped by
; `AdaptiveQuality` (2.2 Mpx) and by the F7 render-quality key.
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/dpi/allow_hidpi=true

[audio]

; Native tape-delay DJ-tag chain (Delay → LowPass → Reverb) and the crowd/stinger buses.
buses/default_bus_layout="res://assets/audio/default_bus_layout.tres"

[physics]

common/physics_ticks_per_second=60

[rendering]

; The Web export must run on WebGL2 (GL Compatibility). The desktop renderer is
; unchanged: only the `web` feature override is set.
;
; PART 3 commit 8 turns ETC2/ASTC import ON. Only textures imported as
; VRAM-compressed are affected, and the only one is the delivered
; jamaican_speaker.glb albedo: it is 2048 px, mipmapped and VRAM-compressed, so the
; Web export needs a compressed variant for the device actually playing. Desktop
; Chrome (including Intel Chromebooks) takes the S3TC variant; iPhone Safari's
; WebGL2 takes the ETC2 one. Every fighter and crowd albedo stays Lossless, so this
; setting changes nothing about them.
renderer/rendering_method.web="gl_compatibility"
textures/vram_compression/import_etc2_astc=true

; PART B commit 5 — crisp rendering.
;
; MSAA 3D is supported in the Compatibility renderer (Godot 4.5 renderer overview: "MSAA 3D
; ✔ Supported" for Compatibility, and the 3D-antialiasing page says it is available in all
; renderers), so 2× is the project default here and 4× is one F7 press away. 2D MSAA is *not*
; supported in Compatibility, which costs nothing: the HUD is drawn geometry and text.
anti_aliasing/quality/msaa_3d=1
; 8× anisotropic filtering (0 = off, 1 = 2×, 2 = 4×, 3 = 8×, 4 = 16×); the delivered
; character, crowd and prop albedos all import with mipmaps, and the cel samplers ask for
; linear-mipmap-anisotropic, so the sand and the barrier converge instead of shimmering.
textures/default_filters/anisotropic_filtering_level=3
; Bilinear 3D scaling (FSR 2.2 is Forward+ only). AdaptiveQuality writes the scale at boot and
; under load; the HUD stays at canvas resolution because only 3D is downscaled.
scaling_3d/mode=0
