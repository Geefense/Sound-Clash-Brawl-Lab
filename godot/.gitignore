# Godot 4 ignores.
# The repository-root .gitignore still applies; these rules cover the engine.

# Godot 4 cache and imported resources
.godot/
.import/

# Editor settings that are machine-specific. `export_presets.cfg` is deliberately
# committed: it holds the Chromebook Web export preset, so the playtest build is
# reproducible from a clean clone.
export.cfg

# Imported translations generated from CSV
*.translation

# Mono/.NET artefacts (unused today, ignored so an accidental build never lands)
.mono/
data_*/
mono_crash.*.json

# Exported builds and temporary renders
/build/
/exports/
/tmp/
*.zip
*.pck
*.exe
*.dmg
*.apk
*.aab

# OS and editor cruft
.DS_Store
Thumbs.db
*.swp
*~
